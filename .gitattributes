# Default: normalize semua text file ke LF
* text=auto eol=lf

# Explicitly LF untuk file-file ini
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary — jangan disentuh
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary